{
  "manifest_version": 3,
  "name": "Twitter (𝕏) AI Assistant: Auto Reply & Post Creator",
  "version": "2.0.0",
  "description": "Generate intelligent auto-replies and craft viral tweets on Twitter (X) using Gemini Nano, Cloud API, Custom API, or Gemini Web.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "offscreen",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://gemini.google.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "content_twitter.js"
      ],
      "css": [
        "content_twitter.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content_gemini.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
