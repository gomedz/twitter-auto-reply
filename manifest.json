{
  "manifest_version": 3,
  "name": "Twitter AI Auto Reply (Gemini Web)",
  "version": "1.1.0",
  "description": "Generate intelligent auto-replies on Twitter (X) using your logged-in Gemini session without any API key.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "offscreen",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["content_twitter.js"],
      "css": ["content_twitter.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": ["content_gemini.js"],
      "run_at": "document_idle"
    }
  ]
}
